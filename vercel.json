{
    "version": 2,
    "builds": [
        {
            "src": "api/index.cjs",
            "use": "@vercel/node",
            "config": {
                "includeFiles": "fronted/**"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.cjs"
        }
    ]
}
